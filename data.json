{
    "model": "prompts.prompt",
    "pk": 1,
    "fields": {
        "title": "Python Lists Explained Simply",
        "description": "A beginner-friendly prompt for learning Python lists, including creation, indexing, slicing, methods, and practical examples.",
        "author": 2,
        "created_at": "2026-05-15T19:29:34.823Z",
        "updated_at": "2026-05-24T19:19:21.211Z",
        "content": "Explain Python lists in a simple and beginner-friendly way.\r\nInclude:\r\n- what lists are\r\n- how to create them\r\n- indexing\r\n- slicing\r\n- common methods like append(), remove(), pop()\r\n- loops with lists\r\n- practical examples\r\n\r\nUse clear explanations and short code examples.",
        "categories": [
            2,
            1
        ]
    }
},
{
    "model": "prompts.prompt",
    "pk": 2,
    "fields": {
        "title": "How to create a music track",
        "description": "A step-by-step guide to creating a music track — from structure and lyrics to production and home studio tips.",
        "author": 4,
        "created_at": "2026-05-17T12:20:51.512Z",
        "updated_at": "2026-05-17T12:20:51.512Z",
        "content": "I want to create a music track in the genre of [genre, e.g. pop / jazz / electronic]. \r\nHelp me step by step: suggest a song structure (intro, verse, chorus, bridge, outro), \r\nwrite the lyrics, choose a key and tempo (BPM), describe the instrumentation and \r\neffects to use during production. Finally, give me tips on how to record or produce \r\nthis track in a home studio.",
        "categories": [
            7
        ]
    }
},
{
    "model": "prompts.prompt",
    "pk": 8,
    "fields": {
        "title": "Creation of candle",
        "description": "prompt of how to create own candle at home",
        "author": 1,
        "created_at": "2026-05-24T20:15:48.838Z",
        "updated_at": "2026-05-24T20:15:48.838Z",
        "content": "Create a detailed step-by-step guide on how to make a handmade scented candle at home. Include materials needed, safety tips, melting wax process, fragrance mixing, pouring technique, and cooling instructions. Make it beginner-friendly and easy to follow.",
