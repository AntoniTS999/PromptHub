            37
        ]
    }
},
{
    "model": "prompts.prompt",
    "pk": 9,
    "fields": {
        "title": "Pet haircut at home",
        "description": "prompt for tutorial for haircut of your pet at home",
        "author": 3,
        "created_at": "2026-05-24T20:21:22.612Z",
        "updated_at": "2026-05-24T20:21:22.612Z",
        "content": "Create a step-by-step guide on how to safely give a pet (dog or cat) a haircut at home. Include preparation steps, required tools, how to keep the animal calm, how to trim different areas (body, paws, face), safety precautions to avoid injuries, and post-grooming care. Make it beginner-friendly and stress safe handling throughout the process.",
        "categories": [
            37,
            38
        ]
    }
},
