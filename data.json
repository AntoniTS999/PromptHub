w=", "last_login": null, "is_superuser": false, "username": "black_jack", "first_name": "", "last_name": "", "email": "", "is_staff": false, "is_active": true, "date_joined": "2026-05-17T12:20:23.159Z", "display_name": "Jack Black", "groups": [], "user_permissions": []}}, {"model": "prompts.author", "pk": 5, "fields": {"password": "pbkdf2_sha256$1200000$H6CMdMnSsXpkC4V4nGU5Mg$Q2h2IUOnLM+VzpcmaPPPc2ppFpwSCrWE/KnHzPJy1M0=", "last_login": null, "is_superuser": false, "username": "moni_bel", "first_name": "Monika", "last_name": "Belluchi", "email": "monia_bel@gmail.com", "is_staff": false, "is_active": true, "date_joined": "2026-05-18T19:33:27.145Z", "display_name": "Monika Beluchi", "groups": [], "user_permissions": []}}, {"model": "prompts.prompt", "pk": 1, "fields": {"title": "Python Lists Explained Simply", "description": "A beginner-friendly prompt for learning Python lists, including creation, indexing, slicing, methods, and practical examples.", "author": 2, "created_at": "2026-05-15T19:29:34.823Z", "updated_at": "2026-05-24T19:19:21.211Z", "content": "Explain Python lists in a simple and beginner-friendly way.\r\nInclude:\r\n- what lists are\r\n- how to create them\r\n- indexing\r\n- slicing\r\n- common methods like append(), remove(), pop()\r\n- loops with lists\r\n- practical examples\r\n\r\nUse clear explanations and short code examples.", "categories": [2, 1]}}, {"model": "prompts.prompt", "pk": 2, "fields": {"title": "How to create a music track", "description": "A step-by-step guide to creating a music track — from structure and lyrics to production and home studio tips.", "author": 4, "created_at": "2026-05-17T12:20:51.512Z", "updated_at": "2026-05-17T12:20:51.512Z", "content": "I want to create a music track in the genre of [genre, e.g. pop / jazz / electronic]. \r\nHelp me step by step: suggest a song structure (intro, verse, chorus, bridge, outro), \r\nwrite the lyrics, choose a key and tempo (BPM), describe the instrumentation and \r\neffects to use during production. Finally, give me tips on how to record or produce \r\nthis track in a home studio.", "categories": [7]}}, {"model": "prompts.prompt", "pk": 8, "fields": {"title": "Creation of candle", "description": "prompt of how to create own candle at home", "author": 1, "created_at": "2026-05-24T20:15:48.838Z", "updated_at": "2026-05-24T20:15:48.838Z", "content": "Create a detailed step-by-step guide on how to make a handmade scented candle at home. Include materials needed, safety tips, melting wax process, fragrance mixing, pouring technique, and cooling instructions. Make it beginner-friendly and easy to follow.", "categories": [37]}}, {"model": "prompts.prompt", "pk": 9, "fields": {"title": "Pet haircut at home", "description": "prompt for tutorial for haircut of your pet at home", "author": 3, "created_at": "2026-05-24T20:21:22.612Z", "updated_at": "2026-05-24T20:21:22.612Z", "content": "Create a step-by-step guide on how to safely give a pet (dog or cat) a haircut at home. Include preparation steps, required tools, how to keep the animal calm, how to trim different areas (body, paws, face), safety precautions to avoid injuries, and post-grooming care. Make it beginner-friendly and stress safe handling throughout the process.", "categories": [37, 38]}}, {"model": "prompts.rating", "pk": 1, "fields": {"value": 5, "user": 1, "prompt": 1}}, {"model": "prompts.rating", "pk": 2, "fields": {"value": 3, "user": 3, "prompt": 1}}, {"model": "prompts.rating", "pk": 3, "fields": {"value": 5, "user": 2, "prompt": 1}}, {"model": "prompts.rating", "pk": 4, "fields": {"value": 5, "user": 1, "prompt": 2}}, {"model": "prompts.rating", "pk": 5, "fields": {"value": 1, "user": 2, "prompt": 2}}, {"model": "prompts.rating", "pk": 7, "fields": {"value": 2, "user": 1, "prompt": 8}}, {"model": "prompts.comment", "pk": 1, "fields": {"content": "very good prompt, helpful!", "created_at": "2026-05-15T19:35:19.581Z", "user": 1, "prompt": 1}}, {"model": "prompts.comment", "pk": 2, "fi